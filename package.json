{
  "name": "dsh-opensandbox",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSandbox executor for the DeepSeek Harness bash capability seam: run commands inside an OpenSandbox sandbox through its execd API.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-shell": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.5",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}